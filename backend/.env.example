# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Google sign-in (public OAuth client ID; must match VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=204776161734-9rps1vulqt0o979mldhl1arf3nrv6gtl.apps.googleusercontent.com

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Test keys start sk_test, live sk_live.
# Set the webhook URL there to: https://primeticketsoko.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=KES

# Public site URL — used for payment return links and ticket QR codes
SITE_URL=https://primeticketsoko.com

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Brevo (production): Brevo → SMTP & API → SMTP tab. SMTP_USER is the
#   "Login" shown there (xxxx@smtp-brevo.com), SMTP_PASS an SMTP key.
#   MAIL_FROM must be on a domain verified in Brevo → Senders & Domains.
# Gmail (testing): app password from myaccount.google.com/apppasswords,
#   SMTP_HOST=smtp.gmail.com, and leave MAIL_FROM empty.
# Test with: node backend/scripts/send-test-email.js you@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_login@smtp-brevo.com
SMTP_PASS=your_smtp_key_here
MAIL_FROM=noreply@primeticketsoko.com
MAIL_FROM_NAME=PrimeTickets
# Optional: where replies go (e.g. a support inbox), since noreply isn't read
MAIL_REPLY_TO=

# ─── WhatsApp & SMS (Twilio) ──────────────────────────────────────────────────
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp sender — use Twilio sandbox: whatsapp:+14155238886 (testing)
# or your approved number after going live
TWILIO_WHATSAPP_FROM=+14155238886

# SMS sender — a Twilio phone number you purchased
TWILIO_SMS_FROM=+12025551234

# Country dialling code for normalising local numbers (27=SA, 254=Kenya)
PHONE_COUNTRY_CODE=27
